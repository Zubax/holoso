fn equal_temperament(note: float):
    output [0]: float
    output [1]: float
    %0: float = intrinsic add(note, -69.0)
    %1: float = intrinsic div(%0, 12.0)
    %2: float = intrinsic round(%1)
    %3: bool = intrinsic frelational<eq>(%2, %1)
    %4: float = intrinsic mul(%1, 0.5)
    %5: float = intrinsic round(%4)
    %6: bool = intrinsic frelational<ne>(%5, %4)
    %7: bool = intrinsic frelational<eq>(%1, 0.0)
    %8: bool = intrinsic bor(%7, False)
    %9: bool = intrinsic isinf(%1)
    %10: bool = intrinsic band(False, %9)
    %11: bool = intrinsic bor(%8, %10)
    if %11:
        %26: float = 1.0
    else:
        %12: bool = intrinsic frelational<eq>(%1, 1.0)
        if %12:
            %25: float = 2.0
        else:
            %13: bool = intrinsic frelational<eq>(%1, 2.0)
            if %13:
                %24: float = 4.0
            else:
                %14: bool = intrinsic frelational<eq>(%1, 3.0)
                if %14:
                    %23: float = 8.0
                else:
                    %15: bool = intrinsic frelational<eq>(%1, 4.0)
                    if %15:
                        %22: float = 16.0
                    else:
                        %16: float = intrinsic mul(%1, 1.0)
                        %17: float = intrinsic exp2(%16)
                        %18: bool = intrinsic band(False, %3)
                        %19: bool = intrinsic band(%18, %6)
                        if %19:
                            %20: float = intrinsic neg(%17)
                            %21: float = %20
                        else:
                            %21: float = %17
                        %22: float = %21
                    %23: float = %22
                %24: float = %23
            %25: float = %24
        %26: float = %25
    %27: float = intrinsic mul(440.0, %26)
    %28: float = intrinsic div(%27, 440.0)
    %29: float = intrinsic log2(%28)
    %30: float = intrinsic mul(12.0, %29)
    %31: float = intrinsic add(69.0, %30)
    return %27, %31
