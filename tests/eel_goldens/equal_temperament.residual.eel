fn equal_temperament(note: float):
    output [0]: float
    output [1]: float
    %0: float = intrinsic add(note, -69.0)
    %1: float = intrinsic div(%0, 12.0)
    %2: float = intrinsic round(%1)
    %3: bool = intrinsic frelational<eq>(%2, %1)
    %4: float = intrinsic mul(%1, 0.5)
    %5: float = intrinsic round(%4)
    %6: bool = intrinsic frelational<ne>(%5, %4)
    %7: bool = intrinsic frelational<eq>(%1, 0.0)
    %8: bool = intrinsic bor(%7, False)
    %9: bool = intrinsic isinf(%1)
    %10: bool = intrinsic band(False, %9)
    %11: bool = intrinsic bor(%8, %10)
    if %11:
        %24: float = 1.0
    else:
        %12: bool = intrinsic frelational<eq>(%1, 1.0)
        if %12:
            %23: float = 2.0
        else:
            %13: bool = intrinsic frelational<eq>(%1, 2.0)
            if %13:
                %22: float = 4.0
            else:
                %14: bool = intrinsic frelational<eq>(%1, 3.0)
                if %14:
                    %21: float = 8.0
                else:
                    %15: float = intrinsic mul(%1, 1.0)
                    %16: float = intrinsic exp2(%15)
                    %17: bool = intrinsic band(False, %3)
                    %18: bool = intrinsic band(%17, %6)
                    if %18:
                        %19: float = intrinsic neg(%16)
                        %20: float = %19
                    else:
                        %20: float = %16
                    %21: float = %20
                %22: float = %21
            %23: float = %22
        %24: float = %23
    %25: float = intrinsic mul(440.0, %24)
    %26: float = intrinsic div(%25, 440.0)
    %27: float = intrinsic log2(%26)
    %28: float = intrinsic mul(12.0, %27)
    %29: float = intrinsic add(69.0, %28)
    return %25, %29
