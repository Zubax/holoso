fn equal_temperament(note: float):
    output [0]: float
    output [1]: float
    %0: float = intrinsic add(note, -69.0)
    %1: float = intrinsic div(%0, 12.0)
    %2: float = intrinsic round(%1)
    %3: bool = intrinsic frelational<eq>(%2, %1)
    %4: float = intrinsic mul(%1, 0.5)
    %5: float = intrinsic round(%4)
    %6: bool = intrinsic frelational<ne>(%5, %4)
    %7: bool = intrinsic frelational<eq>(%1, 0.0)
    %8: bool = intrinsic bor(%7, False)
    %9: bool = intrinsic isinf(%1)
    %10: bool = intrinsic band(False, %9)
    %11: bool = intrinsic bor(%8, %10)
    if %11:
        %18: float = 1.0
    else:
        %12: float = intrinsic mul(%1, 1.0)
        %13: float = intrinsic exp2(%12)
        %14: bool = intrinsic band(False, %3)
        %15: bool = intrinsic band(%14, %6)
        if %15:
            %16: float = intrinsic neg(%13)
            %17: float = %16
        else:
            %17: float = %13
        %18: float = %17
    %19: float = intrinsic mul(440.0, %18)
    %20: float = intrinsic div(%19, 440.0)
    %21: float = intrinsic log2(%20)
    %22: float = intrinsic mul(12.0, %21)
    %23: float = intrinsic add(69.0, %22)
    return %19, %23
