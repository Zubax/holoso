fn octave_index(x: float):
    output [0]: float
    %0: float = intrinsic abs(x)
    %1: bool = intrinsic fge(%0, 1.0)
    if %1:
        %3: float = %0
    else:
        %2: float = intrinsic div(1.0, %0)
        %3: float = %2
    phi %5: float = 0.0 -> %9
    phi %6: float = %3 -> %8
    while:
        %7: bool = intrinsic fgt(%6, 1.0)
    do %7:
        %8: float = intrinsic mul(%6, 0.5)
        %9: float = intrinsic add(%5, 1.0)
    return %5
