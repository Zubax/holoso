fn __call__(setpoint: float, measurement: float, dt: float, /):
    state _started: bool reset False
    state integral: float reset 0.0
    state prev_error: float reset 0.0
    output [0]: float
    %0: bool = slot _started
    %1: float = slot integral
    %2: float = slot prev_error
    %3: float = intrinsic neg(measurement)
    %4: float = intrinsic add(setpoint, %3)
    %5: float = intrinsic mul(0.0625, %4)
    %6: float = intrinsic mul(%5, dt)
    %7: float = intrinsic add(%1, %6)
    if %0:
        %8: float = intrinsic neg(%2)
        %9: float = intrinsic add(%4, %8)
        %10: float = intrinsic mul(0.25, %9)
        %11: float = intrinsic div(%10, dt)
        %12: float = %11
    else:
        %12: float = 0.0
    %13: float = intrinsic mul(0.5, %4)
    %14: float = intrinsic add(%13, %7)
    %15: float = intrinsic add(%14, %12)
    %16: bool = intrinsic fgt(%15, 4.0)
    if %16:
        %20: float = 4.0
        %21: float = %1
    else:
        %17: bool = intrinsic flt(%15, -4.0)
        if %17:
            %18: float = -4.0
            %19: float = %1
        else:
            %18: float = %15
            %19: float = %7
        %20: float = %18
        %21: float = %19
    slot _started = True
    slot integral = %21
    slot prev_error = %4
    return %20
