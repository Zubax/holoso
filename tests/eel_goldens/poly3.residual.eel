fn poly3(x: float, c0: float, c1: float, c2: float, c3: float):
    output [0]: float
    %0: float = intrinsic mul(c3, x)
    %1: float = intrinsic add(%0, c2)
    %2: float = intrinsic mul(%1, x)
    %3: float = intrinsic add(%2, c1)
    %4: float = intrinsic mul(%3, x)
    %5: float = intrinsic add(%4, c0)
    return %5
