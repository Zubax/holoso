fn __call__(self, x, /):
    %0 = 0.5 * x
    y = 1.5 - %0
    delta = 1.0
    while:
        %1 = env abs
        %2 = call %1(delta)
        %3 = self.tolerance
        %4 = %2 > %3
    do %4:
        %5 = x * y
        %6 = 2.0 - %5
        y_next = y * %6
        delta = y_next - y
        y = y_next
    return y
